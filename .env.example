# These are Firebase public client project config values, NOT server credentials.
# Do not put Firebase ADMIN service-account keys, private tokens or secrets under VITE_.
VITE_APP_ID=blockverse-staging
VITE_FIREBASE_CONFIG={"apiKey":"PASTE_WEB_API_KEY","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","appId":"YOUR_WEB_APP_ID","messagingSenderId":"YOUR_SENDER_ID"}
# Leave blank to use guest/offline DEMO mode, not cloud multiplayer.

# VPS-hosted real multiplayer. Example: wss://multiplayer.yourdomain.com/ws
# When set, the game uses the VPS server rather than BroadcastChannel/Firestore presence.
VITE_MULTIPLAYER_URL=
