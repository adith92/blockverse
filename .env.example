# BLOCKVERSE WebSocket + optional Supabase cloud persistence (safe browser config only)
VITE_APP_ID=blockverse-staging
VITE_MULTIPLAYER_URL=
# URL is public information, but do not enable until schema/RLS have been approved and verified.
VITE_SUPABASE_URL=
# ONLY sb_publishable_... ; NEVER use sbp_... personal token, sb_secret_ or service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty Supabase env means safe offline IndexedDB mode.
