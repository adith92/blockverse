{
  "name": "blockverse",
  "version": "1.2.0",
  "private": true,
  "description": "BLOCKVERSE original 3D browser sandbox; cloud persistence with strict Firestore rules",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "npm run test:unit",
    "check": "npm run test && npm run build",
    "zip": "node scripts/create-zip.mjs",
    "test:unit": "node --test tests/schema.test.mjs tests/integrity.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --project blockverse-ci --only firestore \"node --test tests/firestore-emulator.test.mjs\""
  },
  "dependencies": {
    "firebase": "11.6.1",
    "three": "0.168.0"
  },
  "devDependencies": {
    "vite": "5.4.8",
    "tailwindcss": "3.4.17",
    "postcss": "8.4.49",
    "autoprefixer": "10.4.20",
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase-tools": "13.35.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
