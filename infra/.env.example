MULTIPLAYER_DOMAIN=multiplayer.example.com
ALLOWED_ORIGINS=https://your-vercel-staging.vercel.app,https://your-game-domain.example

# Optional local AI NPC services (no cloud API keys; separate Ollama container opt-in)
NPC_LLM_ENABLED=0
OLLAMA_MODEL=qwen3:4b
# CPU/GPU/RAM provisioned VPS required; docker compose --profile ai up -d --build
# Important: Piper executable is NOT bundled in this Node-Alpine container.
