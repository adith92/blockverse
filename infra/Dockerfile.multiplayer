# Single-origin BLOCKVERSE image: built frontend + WebSocket + NPC API.
# Ollama (LLM) and Piper (neural voice) require separately provisioned local model runtimes.
FROM node:24-alpine AS builder
WORKDIR /build
COPY package.json ./
RUN npm install --no-fund --no-audit
COPY index.html vite.config.js ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM node:24-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY server/package.json ./server/
RUN cd server && npm install --omit=dev --no-audit --no-fund
COPY server/*.mjs ./server/
COPY src/npc/catalog.mjs ./src/npc/catalog.mjs
COPY --from=builder /build/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "server/server.mjs"]
